---
import Header from './Header.astro';
import Footer from './Footer.astro';
import CookieBanner from './CookieBanner.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noIndex?: boolean;
  schema?: string;
  article?: boolean;
  pubDate?: string;
  modifiedDate?: string;
}

const {
  title,
  description = 'Ghiduri de cumparaturi si comparatii de preturi pentru bijuterii, ceasuri si accesorii. Afla ce merita si la ce pret.',
  canonical,
  ogImage = '/images/default-og.svg',
  noIndex = false,
  schema,
  article = false,
  pubDate,
  modifiedDate,
} = Astro.props;

const siteUrl = 'https://tekabijoux.ro';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href;
---
<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:site_name" content="TekaBijoux" />
  <meta property="og:locale" content="ro_RO" />

  {article && pubDate && <meta property="article:published_time" content={pubDate} />}
  {article && modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap_index.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  {schema && <script type="application/ld+json" set:html={schema} />}
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <CookieBanner />
</body>
</html>
