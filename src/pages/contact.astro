---
import Layout from '../components/Layout.astro';
---
<Layout
  title="Contact - TekaBijoux"
  description="Contacteaza echipa TekaBijoux pentru intrebari, sugestii sau colaborari."
>
  <div class="contact-wrap">
    <h1>Contact</h1>
    <p class="sub">
      Ai o intrebare despre un articol, vrei sa ne semnalezi o eroare sau doresti sa colaboram? Scrie-ne un email si iti vom raspunde cat mai curand posibil.
    </p>
    <div class="contact-box">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="M22 4L12 13 2 4"/>
      </svg>
      <a href="mailto:contact@tekabijoux.ro">contact@tekabijoux.ro</a>
    </div>
  </div>
</Layout>
