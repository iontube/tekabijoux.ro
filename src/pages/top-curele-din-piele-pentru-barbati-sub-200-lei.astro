const authorInitials = "DP";
const schema = "[{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"cat costa o curea de piele naturala barbati sub 200 lei\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"O curea de piele naturala barbati sub 200 lei are preturi ce variaza intre 100 si 199 lei. Cele mai multe modele bune se gasesc in intervalul 120-170 lei, oferind un echilibru bun intre calitate si pret.\"}},{\"@type\":\"Question\",\"name\":\"care e diferenta intre piele naturala si piele ecologica la curele\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Pielea naturala este obtinuta din pielea animalelor, este respirabila, durabila si se muleaza pe corp. Pielea ecologica este un material sintetic, adesea din poliuretan, care imita pielea, dar se poate crapa, nu respira la fel de bine si are o durata de viata mai scurta.\"}},{\"@type\":\"Question\",\"name\":\"cum aleg marimea corecta pentru o curea barbati\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Masura talia in dreptul unde vei purta cureaua sau masoara o curea pe care o porti deja, de la catarama pana la gaura cea mai folosita. In general, o curea de 110-115 cm este potrivita pentru majoritatea barbatilor. Verifica ghidul de marimi al producatorului.\"}},{\"@type\":\"Question\",\"name\":\"merita sa cumpar o curea de piele intoarsa\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Da, merita daca stilul tau este casual si relaxat. Pielea intoarsa ofera un aspect unic si o textura placuta. Necesita insa ingrijire speciala si nu este potrivita pentru tinute formale. E un accesoriu statement.\"}},{\"@type\":\"Question\",\"name\":\"cum ingrijesc o curea din piele naturala\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Curata cureaua cu o carpa umeda sau o perie moale. Dupa utilizare, las-o sa se usuce natural, departe de soare sau caldura. Aplica periodic un balsam sau o crema de piele pentru a o mentine hidratata si a preveni crapaturile. Pentru pielea intoarsa, foloseste perii si solutii dedicate.\"}}]},{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Acasa\",\"item\":\"https://tekabijoux.ro/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Accesorii Fashion\",\"item\":\"https://tekabijoux.ro/accesorii-fashion/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Top curele din piele pentru barbati sub 200 lei\",\"item\":\"https://tekabijoux.ro/top-curele-din-piele-pentru-barbati-sub-200-lei/\"}]},{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Top curele din piele pentru barbati sub 200 lei\",\"description\":\"Cauti curele de piele pentru barbati sub 200 lei? Ai ajuns unde trebuie. Am adunat cele mai bune optiuni ca sa arati impecabil fara sa dai o avere.\",\"image\":\"https://tekabijoux.ro/images/articles/top-curele-din-piele-pentru-barbati-sub-200-lei.webp\",\"datePublished\":\"2024-02-27T06:15:00.000Z\",\"dateModified\":\"2026-03-05T16:00:39.984Z\",\"author\":{\"@type\":\"Person\",\"name\":\"Diana Popescu\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"TekaBijoux\",\"url\":\"https://tekabijoux.ro\"},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://tekabijoux.ro/top-curele-din-piele-pentru-barbati-sub-200-lei/\"}}]";
const similarArticles = [{"title":"Cele mai bune genti de dama din piele naturala","slug":"cele-mai-bune-genti-de-dama-din-piele-naturala","excerpt":"Daca vrei cele mai bune genti de dama din piele naturala, sincer, nu exista un singur raspuns universal. Totusi, pentru un echilibru excelent intre calitate, stil si pret, iti recomand sa te uiti la branduri precum Coccinelle sau Furla. Sunt branduri italiene consacrate care ofera piele de calitate buna la preturi corecte.","category":"Accesorii Fashion","categorySlug":"accesorii-fashion","date":"2025-07-08T11:30:00.000Z","author":"Diana Popescu"},{"title":"Cele mai bune ochelari de soare pentru femei sub 300 lei","slug":"cele-mai-bune-ochelari-de-soare-pentru-femei-sub-300-lei","excerpt":"Ca sa gasesti cele mai bune ochelari de soare pentru femei sub 300 lei, uita-te la branduri ca Polaroid, Optică Romaneasca (daca au modele in oferta), sau cauta reduceri la nume mai cunoscute. Atenție la protecția UV 400. Nu te lăsa păcălită de branduri obscure care promit mult la preț mic.","category":"Accesorii Fashion","categorySlug":"accesorii-fashion","date":"2024-01-28T05:26:00.000Z","author":"Diana Popescu"},{"title":"Portofele din piele naturala pentru barbati","slug":"portofele-din-piele-naturala-pentru-barbati","excerpt":"Daca vrei un portofel din piele naturala pentru barbati care sa tina o viata si sa arate impecabil, mergi pe piele de vaca, grain top sau full grain, de la branduri consacrate. Modelul clasic cu clapetă sau cel subțire, minimalist, sunt alegeri sigure, undeva la 200-500 lei.","category":"Accesorii Fashion","categorySlug":"accesorii-fashion","date":"2024-02-12T08:31:00.000Z","author":"Diana Popescu"}];
const allArticles = [{"title":"Cele mai bune ceasuri barbatesti sub 500 lei","slug":"cele-mai-bune-ceasuri-barbatesti-sub-500-lei","category":"Ceasuri de Mana","categorySlug":"ceasuri-de-mana","date":"2025-09-12T08:30:00.000Z"},{"title":"Cele mai frumoase lanturi de aur pentru barbati","slug":"cele-mai-frumoase-lanturi-de-aur-pentru-barbati","category":"Bijuterii din Aur","categorySlug":"bijuterii-din-aur","date":"2025-10-05T10:15:00.000Z"},{"title":"Cele mai bune bratari din argint 925 pentru femei","slug":"cele-mai-bune-bratari-din-argint-925-pentru-femei","category":"Bijuterii din Argint","categorySlug":"bijuterii-din-argint","date":"2025-08-20T07:45:00.000Z"},{"title":"Cum alegi inelul de logodna perfect","slug":"cum-alegi-inelul-de-logodna-perfect","category":"Verighete si Logodna","categorySlug":"verighete-si-logodna","date":"2025-11-15T09:00:00.000Z"},{"title":"Cele mai bune genti de dama din piele naturala","slug":"cele-mai-bune-genti-de-dama-din-piele-naturala","category":"Accesorii Fashion","categorySlug":"accesorii-fashion","date":"2025-07-08T11:30:00.000Z"},{"title":"Cele mai bune ceasuri pentru femei sub 300 lei","slug":"cele-mai-bune-ceasuri-pentru-femei-sub-300-lei","category":"Ceasuri de Mana","categorySlug":"ceasuri-de-mana","date":"2024-01-15T05:29:00.000Z"},{"title":"Ceasuri automate barbatesti sub 1000 lei","slug":"ceasuri-automate-barbatesti-sub-1000-lei","category":"Ceasuri de Mana","categorySlug":"ceasuri-de-mana","date":"2024-01-30T06:32:00.000Z"},{"title":"Casio vs Seiko: care e mai bun la pret similar","slug":"casio-vs-seiko-care-e-mai-bun-la-pret-similar","category":"Ceasuri de Mana","categorySlug":"ceasuri-de-mana","date":"2024-02-15T05:45:00.000Z"},{"title":"Cele mai frumoase cercei din aur pentru femei","slug":"cele-mai-frumoase-cercei-din-aur-pentru-femei","category":"Bijuterii din Aur","categorySlug":"bijuterii-din-aur","date":"2024-01-18T08:02:00.000Z"},{"title":"Cele mai bune inele din argint 925 pentru femei","slug":"cele-mai-bune-