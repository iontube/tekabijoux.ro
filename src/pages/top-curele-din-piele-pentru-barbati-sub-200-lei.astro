        <div class="product-review" id="produs-5">
          <div class="product-review__header">
            <span class="section-tag">Produs #5</span>
            <h3>Curea barbati din piele intoarsa 'Casual Vibes'</h3>
            <div class="product-review__specs-grid">
            <div class="product-review__spec"><strong>Material</strong>Piele naturala intoarsa</div>
            <div class="product-review__spec"><strong>Greutate</strong>Aprox. 170g</div>
            <div class="product-review__spec"><strong>Dimensiuni</strong>Latime 3.5 cm, lungimi 100-125 cm</div>
            <div class="product-review__spec"><strong>Certificari</strong>Nu</div>
            <div class="product-review__spec"><strong>Stil</strong>Foarte casual, relaxat, boem</div>
