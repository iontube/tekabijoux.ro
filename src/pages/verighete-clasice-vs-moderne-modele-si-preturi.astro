            <tr><td>Modern Aur Alb 18K Asimetric</td><td>Aur alb 18K</td><td>5.2g</td><td>3-5mm latime variabila</td><td>Abstract, indraznet</td><td>Cupluri creative, iubitori de design unic</td></tr>
            <tr><td>Clasic Bombat Aur Roz 14K</td><td>Aur roz 14K</td><td>4.8g</td><td>5mm latime</td><td>Romantic, confortabil</td><td>Cupluri romantice, confort maxim</td></tr>
            <tr><td>Modern Argint Geometric</td><td>Argint 925</td><td>3.8g</td><td>6mm latime</td><td>Geometric, tineresc</td><td>Cupluri tinere, buget redus, stil modern</td></tr>
