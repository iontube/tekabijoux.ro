const title = "Seturi de bijuterii din argint sub 300 lei";
const description = "Seturi de bijuterii din argint sub 300 lei? Da, exista si arata fantastic.";
const pubDate = "2024-04-20T07:34:00.000Z";
const modifiedDate = "2026-03-13T16:03:39.109Z";
